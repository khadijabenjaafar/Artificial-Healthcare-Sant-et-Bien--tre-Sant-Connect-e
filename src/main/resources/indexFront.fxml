      </HBox>
      <HBox prefHeight="247.0" prefWidth="1262.0" spacing="20.0">
         <children>
      
            <!-- Mission -->
            <VBox alignment="CENTER_LEFT" spacing="10">
               <Label style="-fx-font-weight: bold; -fx-font-size: 32px;" text="Notre Mission:">
                  <font>
                     <Font size="32.0" />
                  </font>
                  <padding>
                     <Insets left="30.0" />
                  </padding>
               </Label>
               <Label maxWidth="700" text="Chez ClinicFlow, nous croyons que la santé doit être accessible à tous. C’est pourquoi nous avons créé une plateforme tout-en-un qui permet de faciliter l’interaction entre les patients, les professionnels de santé, et les équipements médicaux." wrapText="true">
                  <font>
                     <Font size="22.0" />
                  </font>
                  <padding>
                     <Insets left="30.0" />
                  </padding>
               </Label>
            </VBox>
            <ImageView fitHeight="312.0" fitWidth="423.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@img/gallery-3.jpg" />
               </image>
               <HBox.margin>
                  <Insets left="70.0" />
               </HBox.margin>
            </ImageView>
         </children>
      </HBox>
      <fx:include source="AjouterRendezVous.fxml" />
      <fx:include source="freelancer.fxml" />

