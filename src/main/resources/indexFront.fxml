<ScrollPane fx:id="scrollPane" fitToWidth="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.IndexFront">


   <VBox alignment="TOP_CENTER" prefWidth="800" spacing="10.0" style="-fx-background-color: #ffffff;">

      <!-- Logo et Titre -->
