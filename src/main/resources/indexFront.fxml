                  <Font size="20.0" />
               </font></Label>
            <HBox.margin>
               <Insets />
            </HBox.margin>
         </VBox>

         <VBox alignment="CENTER" prefHeight="195.0" prefWidth="218.0" style="-fx-background-color: #F4F7FA; -fx-padding: 10 20 30 40; -fx-border-radius: 10; -fx-background-radius: 10;">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="15" />
            <Label text="Départements">
               <font>
                  <Font size="20.0" />
               </font></Label>
