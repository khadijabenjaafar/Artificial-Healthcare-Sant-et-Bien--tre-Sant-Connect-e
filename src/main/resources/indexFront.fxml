               <Font size="16.0" />
            </font>
            <HBox.margin>
               <Insets />
            </HBox.margin></Button>

         <Button fx:id="inscrire" onAction="#NavigateTosignUp" style="-fx-background-color: #1ca7a2; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 5; -fx-padding: 5 20;" text="S'inscrire">
            <HBox.margin>
