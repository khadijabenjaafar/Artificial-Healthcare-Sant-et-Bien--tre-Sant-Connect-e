<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.EditPlanificationController"
            stylesheets="@styles.css">
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
            <Label text="Edit Planification" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" prefWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <children>
                    <!-- Row 0: Date -->
                    <Label text="Date:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="dateField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <!-- Row 1: Address -->
                    <Label text="Address:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="adresseField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <!-- Row 2: Mode -->
                    <Label text="Mode:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="modeComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <!-- Row 3: Status -->
                    <Label text="Status:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="statutComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <!-- Row 4: Response -->
                    <Label text="Response:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="reponseField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <!-- Row 5: Freelancer -->
                    <Label text="Freelancer:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="freelancerComboBox" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <!-- Row 6: User -->
                    <Label text="User:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="utilisateurComboBox" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                </children>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
                <Button text="Save" onAction="#handleSave" styleClass="confirm-button"/>
            </HBox>
        </VBox>
    </children>
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
</AnchorPane>