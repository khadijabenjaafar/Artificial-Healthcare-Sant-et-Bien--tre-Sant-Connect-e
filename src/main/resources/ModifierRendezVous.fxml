<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="600" prefHeight="500" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ModifierRendezVous"
            style="-fx-background-color: #e6f0f2;">

    <VBox alignment="CENTER" spacing="20.0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          style="-fx-background-color: white; -fx-border-radius: 15px; -fx-background-radius: 15px;
                 -fx-padding: 30px; -fx-spacing: 20px;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);
                 -fx-font-family: 'Segoe UI', Arial, sans-serif;">

        <!-- Titre -->
        <Label text="Modifier Rendez-vous"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #178d87; -fx-padding: 10px 0;"/>

        <!-- Date -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Date:" minWidth="100"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;"/>
            <DatePicker fx:id="datePicker" promptText="Date du rendez-vous"
                        style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                               -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                               -fx-font-size: 15px;"/>
        </HBox>

        <!-- Heure et Minute -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Heure:" minWidth="100"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;"/>
            <Spinner fx:id="heureSpinner" prefWidth="100"
                     style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                            -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 6px;
                            -fx-font-size: 15px;"/>
            <Label text="Minute:" minWidth="80"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;"/>
            <Spinner fx:id="minuteSpinner" prefWidth="100"
                     style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                            -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 6px;
                            -fx-font-size: 15px;"/>
        </HBox>

        <!-- Motif -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Motif:" minWidth="100"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;"/>
            <ComboBox fx:id="motifCombo" promptText="Motif"
                      style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                             -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                             -fx-font-size: 15px;"/>
        </HBox>

        <!-- Statut -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Statut:" minWidth="100"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;"/>
            <ComboBox fx:id="statutCombo" promptText="Statut"
                      style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                             -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                             -fx-font-size: 15px;"/>
        </HBox>

        <!-- Mode -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Mode:" minWidth="100"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;"/>
            <ComboBox fx:id="modeCombo" promptText="Mode"
                      style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                             -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                             -fx-font-size: 15px;"/>
        </HBox>

        <!-- Commentaire -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Commentaire:" minWidth="100"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;"/>
            <TextField fx:id="commentaireField" promptText="Commentaire"
                       style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                              -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                              -fx-font-size: 15px;"/>
        </HBox>

        <!-- Bouton Modifier -->
        <Button fx:id="modifierButton" text="Modifier" onAction="#handleModifierRendezVous"
                style="-fx-background-color: #178d87; -fx-text-fill: white;
                       -fx-font-size: 16px; -fx-border-radius: 10px; -fx-background-radius: 10px;
                       -fx-padding: 10px 20px; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);"/>
    </VBox>
</AnchorPane>
