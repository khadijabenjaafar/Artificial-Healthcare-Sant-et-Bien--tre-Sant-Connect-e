<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.VoirUser">

    <!-- Container principal avec NavBarBack à gauche et contenu à droite -->
    <HBox prefHeight="800.0" prefWidth="1280.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>

            <!-- NavBar incluse -->
            <fx:include source="navBarBack.fxml" />

            <!-- Contenu principal -->
            <VBox prefWidth="1000.0" spacing="10.0" style="-fx-padding: 25px; -fx-background-color: white; -fx-border-color: #053536;">
                <effect>
                    <DropShadow color="#888888" offsetX="5.0" offsetY="5.0" radius="15.0" />
                </effect>
                <children>

                    <!-- Titre principal -->
                    <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="45.0" prefWidth="1000.0" styleClass="title" text="Liste Des Utilisateurs" textAlignment="CENTER">
                        <font>
                            <Font name="System Bold Italic" size="36.0" />
                        </font>
                    </Label>

                    <!-- Barre de recherche -->
                    <HBox alignment="CENTER_RIGHT" spacing="100.0">
                        <children>
                            <TextField fx:id="searchField" prefHeight="42.0" prefWidth="472.0" />
                            <Button mnemonicParsing="false" prefHeight="38.0" prefWidth="149.0" text="Rechercher">
                                <font>
                                    <Font size="18.0" />
                                </font>
                            </Button>
                        </children>
                    </HBox>
                    <HBox spacing="15" style="-fx-padding: 10; -fx-background-color: #f0f0f0;">
                        <Label text="Nom" prefWidth="100"/>
                        <Label text="Prénom" prefWidth="100"/>
                        <Label text="Email" prefWidth="150"/>
                        <Label text="Téléphone" prefWidth="100"/>
                        <Label text="Statut" prefWidth="100"/>
                        <Label text="Genre" prefWidth="100"/>
                        <Label text="Rôle" prefWidth="100"/>
                        <Label text="Action" prefWidth="100"/>
                    </HBox>


                    <!-- Liste des utilisateurs -->
                    <ListView fx:id="UsersList" prefHeight="500.0" prefWidth="950.0">
                        <padding>
                            <Insets bottom="10.0" />
                        </padding>
                    </ListView>

                    <!-- Bouton Ajouter Admin -->
                    <Button fx:id="AddAdmin" onAction="#NavigateToAddAdmin" prefWidth="150" style="-fx-font-size: 14px; -fx-background-color: #4CAF50; -fx-text-fill: white;" text="Ajouter un utilisateur" />
                </children>
            </VBox>
        </children>
    </HBox>
</AnchorPane>
