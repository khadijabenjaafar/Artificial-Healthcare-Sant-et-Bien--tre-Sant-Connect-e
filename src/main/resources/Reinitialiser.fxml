<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom, #f7f8fc, #dff3f5);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.Reinitialiser">

    <!-- Titre principal -->
    <Label alignment="CENTER" layoutY="40.0" prefWidth="1280.0" text="Reinitialiser Votre Mot de passe" textAlignment="CENTER" textFill="#1ca7a2">
        <font>
            <Font size="50.0" />
        </font>
    </Label>

    <!-- Conteneur central type "card" -->
    <AnchorPane layoutX="330.0" layoutY="140.0" prefHeight="520.0" prefWidth="620.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 4);">
        <children>
            <VBox alignment="CENTER" layoutX="50.0" layoutY="30.0" prefWidth="520.0" spacing="25">
                <Label text="Ecrire le mot de passe temporaire" textFill="#2d2d2d">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>
            <PasswordField fx:id="passwordtemp" alignment="CENTER" prefHeight="49.0" prefWidth="471.0" promptText="mot de passe temporaire" style="-fx-background-color: #f1f1f1; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 16;" styleClass="input-field">
               <font>
                  <Font size="18.0" />
               </font>
            </PasswordField>
            <Label text="Ecrire Votre nouveau mot de passe" textFill="#2d2d2d">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <PasswordField fx:id="password" alignment="CENTER" prefHeight="49.0" prefWidth="471.0" promptText="nouveau mot de passe" style="-fx-background-color: #f1f1f1; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 16;" styleClass="input-field">
               <font>
                  <Font size="18.0" />
               </font>
            </PasswordField>
            <Label text="Confirmer votre nouveau mot de passe" textFill="#2d2d2d">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <PasswordField fx:id="Copassword" alignment="CENTER" prefHeight="49.0" prefWidth="471.0" promptText="confirmer mot de passe" style="-fx-background-color: #f1f1f1; -fx-background-radius: 10; -fx-font-size: 16; -fx-padding: 10;" styleClass="input-field">
               <font>
                  <Font size="18.0" />
               </font>
            </PasswordField>
            <Button fx:id="reinitialiser" onAction="#Submit" prefHeight="38.0" prefWidth="131.0" style="-fx-background-color: #1ca7a2; -fx-padding: 10 20; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 18;" styleClass="login-button" text="Réinitialiser" />

            </VBox>
        </children>
    </AnchorPane>

</AnchorPane>
