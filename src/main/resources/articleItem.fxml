<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>
<VBox fx:id="maincontainer"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ArticleItemController"
      spacing="12"
      alignment="TOP_CENTER"
      prefWidth="320"
      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0.3, 0, 2); -fx-padding: 15;">

   <children>
      <!-- Image -->
      <ImageView fx:id="imageView"
                 fitHeight="140"
                 fitWidth="260"
                 preserveRatio="true"
                 style="-fx-background-radius: 8 8 0 0;" />

      <!-- Titre -->
      <Label fx:id="titleLabel"
             style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-alignment: center;"
             wrapText="true" />

      <!-- Résumé -->
      <Label fx:id="contentLabel"
             style="-fx-font-size: 13px; -fx-text-fill: #555;"
             wrapText="true" maxHeight="60" />

      <Separator />

      <!-- Détails -->
      <HBox spacing="10" alignment="CENTER">
         <children>
            <Label fx:id="dateLabel" style="-fx-font-size: 11px; -fx-text-fill: gray;" />
         </children>
      </HBox>

      <!-- Bouton Voir plus -->
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="moreButton"
                    text="Voir plus"
                    onAction="#handleReadMore"
                    style="-fx-background-color: #7fbdc8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 20;" />
         </children>
      </HBox>
   </children>
</VBox>