<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="494.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.StatistiqueConsultation">
    <children>
        <!-- Titre du graphique -->
        <!-- BarChart pour les consultations -->
        <BarChart fx:id="barChart" layoutY="60" prefHeight="400" prefWidth="494.0">
            <!-- Axe X : Mois -->
            <xAxis>
                <CategoryAxis label="Mois" />
            </xAxis>
            <!-- Axe Y : Nombre de consultations -->
            <yAxis>
                <NumberAxis label="Nombre de consultations" />
            </yAxis>
        </BarChart>
    </children>
</AnchorPane>
