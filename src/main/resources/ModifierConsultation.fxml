<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefWidth="600" prefHeight="600" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ModifierConsultation"
            style="-fx-background-color: #e6f0f2;">

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          style="-fx-background-color: white; -fx-border-radius: 15px; -fx-background-radius: 15px;
                 -fx-padding: 30px; -fx-spacing: 20px;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5);
                 -fx-font-family: 'Segoe UI', Arial, sans-serif;">

        <!-- Titre -->
        <Label text="Modifier Consultation"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #178d87; -fx-padding: 10px 0;" />

        <!-- Observation -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Observation :" minWidth="120"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;" />
            <TextField fx:id="observationField" promptText="Observation"
                       style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                              -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                              -fx-font-size: 15px;" prefWidth="400" />
        </HBox>

        <!-- Prix -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Prix :" minWidth="120"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;" />
            <TextField fx:id="prixField" promptText="Prix"
                       style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                              -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                              -fx-font-size: 15px;" prefWidth="400" />
        </HBox>

        <!-- Durée -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Durée :" minWidth="120"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;" />
            <TextField fx:id="dureeField" promptText="Durée"
                       style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                              -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                              -fx-font-size: 15px;" prefWidth="400" />
        </HBox>

        <!-- Prochain RDV -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Prochain RDV :" minWidth="120"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;" />
            <DatePicker fx:id="prochainRdvPicker"
                        style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                               -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                               -fx-font-size: 15px;" prefWidth="400" />
        </HBox>

        <!-- Diagnostic -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Diagnostic :" minWidth="120"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;" />
            <TextArea fx:id="diagnosticArea" promptText="Diagnostic"
                      style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                             -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                             -fx-font-size: 15px;" prefWidth="400" prefHeight="80" wrapText="true" />
        </HBox>

        <!-- Traitement -->
        <HBox spacing="20" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Traitement :" minWidth="120"
                   style="-fx-text-fill: #555555; -fx-font-size: 16px;" />
            <TextArea fx:id="traitementArea" promptText="Traitement"
                      style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;
                             -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 8px;
                             -fx-font-size: 15px;" prefWidth="400" prefHeight="80" wrapText="true" />
        </HBox>

        <!-- Bouton Enregistrer -->
        <Button text="Modifier" onAction="#handleSave"
                style="-fx-background-color: #178d87; -fx-text-fill: white;
                       -fx-font-size: 16px; -fx-border-radius: 10px; -fx-background-radius: 10px;
                       -fx-padding: 10px 20px; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 5);" />
    </VBox>
</AnchorPane>
