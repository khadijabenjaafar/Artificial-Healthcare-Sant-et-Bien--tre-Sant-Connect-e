<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>

<?import javafx.scene.image.Image?>
<VBox fx:id="maincontainer" spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0); -fx-padding: 15;" prefWidth="300" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ArticleItem1Controller">

    <children>
        <!-- Image -->
        <ImageView fx:id="imageView" fitHeight="150" fitWidth="260" preserveRatio="true" style="-fx-background-radius: 8 8 0 0;" />

        <!-- Catégorie ou Auteur -->
        <Label fx:id="categoryLabel" style="-fx-text-fill: #7a7a7a; -fx-font-size: 10px;" wrapText="true"/>

        <!-- Titre -->
        <Label fx:id="titleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true"/>

        <!-- Résumé -->
        <Label fx:id="summaryLabel" style="-fx-font-size: 12px; -fx-text-fill: #555;" wrapText="true" maxHeight="50"/>

        <Separator />

        <!-- Détails -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="dateLabel" style="-fx-font-size: 10px; -fx-text-fill: gray;" />

                <ImageView fitWidth="30" fitHeight="30" preserveRatio="true">
                    <image>
                        <Image url="@images/eye-icon.png" />
                    </image>
                </ImageView>
                <Label fx:id="viewsLabel" style="-fx-font-size: 10px; -fx-text-fill: gray;" />

                <ImageView fitWidth="30" fitHeight="30" preserveRatio="true">
                    <image>
                        <Image url="@images/comment-icon.png" />
                    </image>
                </ImageView>
                <Label fx:id="commentsLabel" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
            </children>
        </HBox>

        <!-- Actions -->
        <HBox spacing="10" alignment="CENTER">
            <children>
                <Button fx:id="readMoreButton" text="Lire plus" onAction="#handleReadMore" style="-fx-background-color: #7fbdc8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 20;" />
                <Button fx:id="editButton" text="Modifier" onAction="#handleClick" style="-fx-background-color: #ffc107; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 20;"/>
                <Button fx:id="deleteButton" text="Supprimer" onAction="#handleDelete" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 20;"/>
            </children>
        </HBox>

    </children>
</VBox>