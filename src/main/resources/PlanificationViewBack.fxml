<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.PlanificationController">

    <!-- Sidebar -->

    <fx:include source="navBarBack.fxml" />

    <!-- Main Content -->
    <VBox layoutX="293.0" layoutY="105.0" prefHeight="661.0" prefWidth="973.0" spacing="20" AnchorPane.bottomAnchor="64.0" AnchorPane.leftAnchor="283.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="95.0">
        <HBox alignment="CENTER" spacing="50.0">
            <Label style="-fx-font-size: 30px; -fx-font-weight: bold;" text="Planifications">
            <font>
               <Font size="37.0" />
            </font></Label>
            <Button fx:id="btnAddPlanification" onAction="#handleAddPlanification" text="Add Planification">
            <HBox.margin>
               <Insets />
            </HBox.margin></Button>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="20" styleClass="search-box">
            <TextField fx:id="searchField" prefHeight="30.0" prefWidth="320.0" promptText="Search...">
            <font>
               <Font size="16.0" />
            </font></TextField>
            <ComboBox fx:id="statusFilter" promptText="Filter by status" />
        </HBox>

        <ListView fx:id="planificationListView" prefHeight="600.0" prefWidth="1153.0" styleClass="list-view" VBox.vgrow="ALWAYS" />
    </VBox>

    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
</AnchorPane>
