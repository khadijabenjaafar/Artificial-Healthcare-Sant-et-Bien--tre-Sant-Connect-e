<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.PlanificationController">

    <!-- Sidebar -->
    <fx:include source="Doctor.fxml" />


    <!-- Main Content -->
    <VBox layoutX="228.8" layoutY="8.8" prefHeight="821.0" prefWidth="1081.0" spacing="10" AnchorPane.bottomAnchor="2.0" AnchorPane.leftAnchor="218.0" AnchorPane.rightAnchor="2.0" AnchorPane.topAnchor="-2.0">
        <HBox alignment="CENTER" spacing="50.0">
            <Label style="-fx-font-size: 30px; -fx-font-weight: bold;" text="Planifications">
            <font>
               <Font size="37.0" />
            </font></Label>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="20" styleClass="search-box">
            <TextField fx:id="searchField" prefHeight="30.0" prefWidth="320.0" promptText="Search...">
            <font>
               <Font size="16.0" />
            </font></TextField>
            <ComboBox fx:id="statusFilter" promptText="Filter by status" />
        </HBox>

        <ListView fx:id="planificationListView" prefHeight="600.0" prefWidth="1153.0" styleClass="list-view" VBox.vgrow="ALWAYS" />
    </VBox>

    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
</AnchorPane>
