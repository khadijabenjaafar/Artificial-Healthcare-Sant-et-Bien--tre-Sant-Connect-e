<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="271.0" prefWidth="386.0" spacing="10" style="-fx-background-color: #f9f9f9;" stylesheets="@chatbot.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ChatbotController">

    <ScrollPane fx:id="chatScrollPane" fitToWidth="true" style="-fx-background-color: transparent;">
        <TextArea fx:id="chatArea" editable="false" style="-fx-font-size: 14px; -fx-control-inner-background: #ffffff; -fx-padding: 10;" wrapText="true" />
    </ScrollPane>

    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
        <TextField fx:id="userInput" promptText="Écrivez votre message ici..." HBox.hgrow="ALWAYS" />
        <Button onAction="#handleSendMessage" text="Envoyer" />
    </HBox>
</VBox>
