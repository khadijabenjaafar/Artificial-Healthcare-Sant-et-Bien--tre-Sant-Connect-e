<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="-Infinity" prefHeight="578.0" prefWidth="596.0" spacing="4.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Controllers.ArticleajoutController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label graphicTextGap="1.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="17.0" prefWidth="33.0" text="titre" />
      <TextField fx:id="titreField" minHeight="-Infinity" prefHeight="28.0" prefWidth="390.0" promptText="Titre" />
      <Label fx:id="errorTitre" style="-fx-text-fill: red;" />
      <Label minHeight="-Infinity" minWidth="-Infinity" prefHeight="22.0" prefWidth="66.0" text="Contenue" />
      <TextArea fx:id="contenueArea" prefHeight="39.0" prefWidth="390.0" promptText="Contenue" text="&#10;" />
      <Label fx:id="errorContenue" style="-fx-text-fill: red;" />
      <Label prefHeight="20.0" prefWidth="48.0" text="image" />
      <HBox prefHeight="30.0" prefWidth="226.0">
         <children>
            <HBox spacing="20.0">
               <children>
                  <Button fx:id="btnChoisirImage" minHeight="20.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="87.0" text="inserer" />
                  <Label fx:id="labelImage" text="url-image">
                     <padding>
                        <Insets top="4.0" />
                     </padding>
                  </Label>
                  <Label fx:id="errorImage" prefHeight="37.0" prefWidth="90.0" style="-fx-text-fill: red;" />
               </children>
            </HBox>
         </children>
      </HBox>
      <ComboBox fx:id="comboUtilisateur" minHeight="10.0" prefHeight="24.0" prefWidth="147.0" />
      <Button fx:id="btnEnregistrer" mnemonicParsing="false" prefHeight="33.0" prefWidth="312.0" text="Enregistrer" textAlignment="CENTER">
         <VBox.margin>
            <Insets left="120.0" top="29.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>
