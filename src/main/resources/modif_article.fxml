<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>

<BorderPane prefHeight="818.0" prefWidth="1000.0" stylesheets="@modif.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ModifierArticleController">
   <top>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
              <fx:include source="Doctor.fxml" />
              <VBox alignment="CENTER" layoutX="253.0" prefHeight="775.0" prefWidth="979.0" spacing="15" style="-fx-padding: 30; -fx-background-color: #F9FAFB;" AnchorPane.leftAnchor="253.0" AnchorPane.topAnchor="20.0">
                  <children>
                      <Label styleClass="title" text="Modifier l'article"  textFill="#44cff2" />
      
                      <TextField fx:id="titreField" promptText="Titre de l'article" styleClass="input-field" />
      
                      <TextArea fx:id="contenuArea" prefRowCount="6" promptText="Contenu" styleClass="textarea-field" />
      
                      <HBox alignment="CENTER" spacing="10">
                          <Button onAction="#insererImage" styleClass="insert-button" text="Insérer une image" />
                          <Label fx:id="urlImageLabel" styleClass="image-label" text="Aucune image sélectionnée" />
                      </HBox>
      
                      <Button onAction="#enregistrer" styleClass="save-button" text="Enregistrer">
                          <textFill>
                              <LinearGradient endX="1.0" endY="1.0">
                                  <stops>
                                      <Stop>
                                          <color>
                                              <Color red="0.6493" green="0.6772" blue="0.6842" />
                                          </color>
                                      </Stop>
                                      <Stop offset="1.0">
                                          <color>
                                              <Color red="0.6734" green="0.7136" blue="0.7236" />
                                          </color>
                                      </Stop>
                                  </stops>
                              </LinearGradient>
                          </textFill>
                      </Button>
                  </children>
              </VBox>
         </children>
      </AnchorPane>
   </top>
</BorderPane>
