<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom, #f7f8fc, #dff3f5);" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ForgetPassword">

    <!-- Titre principal -->
    <Label alignment="CENTER" layoutY="40.0" prefWidth="1280.0" text="Mot De Passe oublié" textAlignment="CENTER" textFill="#1ca7a2">
        <font>
            <Font size="50.0" />
        </font>
    </Label>

    <!-- Conteneur central type "card" -->
    <AnchorPane layoutX="330.0" layoutY="180.0" prefHeight="292.0" prefWidth="620.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 4);">
        <children>
            <VBox alignment="CENTER" layoutX="50.0" layoutY="50.0" prefWidth="520.0" spacing="25">

                <Label text="Ecrire Votre Email" textFill="#2d2d2d">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>

                <TextField fx:id="Email" promptText="Email" style="-fx-background-color: #f1f1f1; -fx-background-radius: 10; -fx-padding: 10; -fx-font-size: 16;" />

                <Button fx:id="oublier" onAction="#Submit" style="-fx-background-color: #1ca7a2; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 12; -fx-padding: 10 20;" text="Envoyer" />

            </VBox>
        </children>
    </AnchorPane>

</AnchorPane>
