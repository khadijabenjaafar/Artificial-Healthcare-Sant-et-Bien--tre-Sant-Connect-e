<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: #ebf0f1;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.AjouterConsultation">

    <children>

        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #ebf0f1;" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>

                <VBox alignment="CENTER" spacing="20.0" prefWidth="700.0" style="-fx-background-color: #ebf0f1;">
                    <VBox.margin>
                        <Insets left="100.0"/> <!-- Décalage vers la droite -->
                    </VBox.margin>
                    <children>

                        <Label layoutX="460.0" layoutY="29.0" text="Ajouter une Consultation" textFill="#178d87">
                            <font>
                                <Font name="Arial Nova Bold" size="40.0" />
                            </font>
                        </Label>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Label style="-fx-text-fill: black; -fx-font-size: 16px;" text="Diagnostic :" />
                                <TextField fx:id="diagnosticField" prefWidth="300.0" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" promptText="Entrez le diagnostic" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Label style="-fx-text-fill: black; -fx-font-size: 16px;" text="Traitement :" />
                                <TextField fx:id="traitementField" prefWidth="300.0" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" promptText="Entrez le traitement" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Label style="-fx-text-fill: black; -fx-font-size: 16px;" text="Observation :" />
                                <TextArea fx:id="observationArea" prefHeight="80.0" prefWidth="300.0" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" promptText="Entrez les observations" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Label style="-fx-text-fill: black; -fx-font-size: 16px;" text="Prix :" />
                                <TextField fx:id="prixField" prefWidth="300.0" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" promptText="Entrez le prix" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Label style="-fx-text-fill: black; -fx-font-size: 16px;" text="Prochain RDV :" />
                                <DatePicker fx:id="prochainRdvPicker" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" promptText="Sélectionnez la date" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Label style="-fx-text-fill: black; -fx-font-size: 16px;" text="Durée :" />
                                <TextField fx:id="dureeField" prefWidth="300.0" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" promptText="Entrez la durée" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Label style="-fx-text-fill: black; -fx-font-size: 16px;" text="Rendez-vous :" />
                                <ComboBox fx:id="comboRendezVous" prefWidth="300.0" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" promptText="Sélectionnez un rendez-vous" />
                            </children>
                        </HBox>

                        <Button fx:id="btnAjouterConsultation" onAction="#ajouterConsultation" prefWidth="500.0" style="-fx-background-color: #80b4bc; -fx-text-fill: white; -fx-font-family: 'MS Roman'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 12px; -fx-padding: 10 24;" text="Ajouter " />

                    </children>
                </VBox>

            </children>
        </VBox>

        <fx:include source="Doctor.fxml" />

    </children>

</AnchorPane>
