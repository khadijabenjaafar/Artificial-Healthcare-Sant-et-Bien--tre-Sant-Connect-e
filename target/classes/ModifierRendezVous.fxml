<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="700.0" spacing="20.0" style="-fx-background-color: #1ca7a2;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ModifierRendezVous">
    <children>

        <!-- Titre -->
        <Label style="-fx-text-fill: white; -fx-font-family: 'MS Roman'; -fx-font-size: 32px; -fx-font-weight: bold;" text="Modifier le rendez-vous" VBox.vgrow="NEVER" />

        <!-- Date et Heure -->
        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
            <Label style="-fx-text-fill: white; -fx-font-family: 'MS Roman'; -fx-font-size: 16px;" text="Date et Heure :">
                <HBox.margin>
                    <Insets right="60.0" />
                </HBox.margin>
            </Label>
            <DatePicker fx:id="datePicker" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" />
            <Spinner fx:id="spinnerHeure" editable="true" min="0" max="23" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" />
            <Spinner fx:id="spinnerMinute" editable="true" min="0" max="59" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" />
        </HBox>
        <Label fx:id="dateErrorLabel" style="-fx-text-fill: red;" visible="false" />

        <!-- Motif -->
        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
            <Label style="-fx-text-fill: white; -fx-font-family: 'MS Roman'; -fx-font-size: 16px;" text="Motif :">
                <HBox.margin>
                    <Insets right="120.0" />
                </HBox.margin>
            </Label>
            <ComboBox fx:id="comboMotif" prefWidth="250" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" />
        </HBox>
        <Label fx:id="motifErrorLabel" style="-fx-text-fill: red;" visible="false" />

        <!-- Statut -->
        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
            <Label style="-fx-text-fill: white; -fx-font-family: 'MS Roman'; -fx-font-size: 16px;" text="Statut :">
                <HBox.margin>
                    <Insets right="120.0" />
                </HBox.margin>
            </Label>
            <ComboBox fx:id="comboStatut" prefWidth="250" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" />
        </HBox>
        <Label fx:id="statutErrorLabel" style="-fx-text-fill: red;" visible="false" />

        <!-- Mode -->
        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
            <Label style="-fx-text-fill: white; -fx-font-family: 'MS Roman'; -fx-font-size: 16px;" text="Mode :">
                <HBox.margin>
                    <Insets right="120.0" />
                </HBox.margin>
            </Label>
            <ComboBox fx:id="comboMode" prefWidth="250" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" />
        </HBox>
        <Label fx:id="modeErrorLabel" style="-fx-text-fill: red;" visible="false" />

        <!-- Commentaire -->
        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
            <Label style="-fx-text-fill: white; -fx-font-family: 'MS Roman'; -fx-font-size: 16px;" text="Commentaire :">
                <HBox.margin>
                    <Insets right="60.0" />
                </HBox.margin>
            </Label>
            <TextArea fx:id="commentaireArea" prefHeight="100.0" prefWidth="300.0" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" />
        </HBox>
        <Label fx:id="labelErrorCommentaire" style="-fx-text-fill: red;" visible="false" />

        <!-- Médecin -->
        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
            <Label style="-fx-text-fill: white; -fx-font-family: 'MS Roman'; -fx-font-size: 16px;" text="Médecin :">
                <HBox.margin>
                    <Insets right="120.0" />
                </HBox.margin>
            </Label>
            <ComboBox fx:id="comboMedecin" prefWidth="250" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" />
        </HBox>
        <Label fx:id="medecinErrorLabel" style="-fx-text-fill: red;" visible="false" />

        <!-- Patient -->
        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="NEVER">
            <Label style="-fx-text-fill: white; -fx-font-family: 'MS Roman'; -fx-font-size: 16px;" text="Patient :">
                <HBox.margin>
                    <Insets right="120.0" />
                </HBox.margin>
            </Label>
            <ComboBox fx:id="comboPatient" prefWidth="250" style="-fx-background-radius: 8; -fx-background-color: white; -fx-padding: 6;" />
        </HBox>
        <Label fx:id="patientErrorLabel" style="-fx-text-fill: red;" visible="false" />

        <!-- Bouton Modifier -->
        <Button fx:id="btnModifier"
                text="Modifier"
                prefWidth="500.0"
                style="-fx-background-color: white; -fx-text-fill: #0d47a1; -fx-font-family: 'MS Roman'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 12px; -fx-padding: 10 24;"
                VBox.vgrow="NEVER"
                onAction="#modifierRendezVous" />
    </children>
</VBox>
