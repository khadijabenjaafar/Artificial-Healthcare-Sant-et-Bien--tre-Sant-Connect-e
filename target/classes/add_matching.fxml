
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.AddMatchingController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: #F4F4F9;">

    <VBox spacing="20" alignment="TOP_CENTER" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <Label text="Add New Matching" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

        <GridPane hgap="15" vgap="15">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="CIN:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-size: 14px;"/>
            <TextField fx:id="cinField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CCCCCC;"/>

            <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 14px;"/>
            <TextArea fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefRowCount="3"
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CCCCCC;"/>

            <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 14px;"/>
            <DatePicker fx:id="dateField" GridPane.columnIndex="1" GridPane.rowIndex="2"
                        style="-fx-background-radius: 8; -fx-border-radius: 8;"/>

            <Label text="Compétences:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-size: 14px;"/>
            <TextField fx:id="competencesField" GridPane.columnIndex="1" GridPane.rowIndex="3"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CCCCCC;"/>

            <Label text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-size: 14px;"/>
            <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="4"
                       style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CCCCCC;"/>
        </GridPane>

        <HBox spacing="20" alignment="CENTER">
            <Button text="Save" onAction="#handleSave"
                    style="-fx-background-color: #22c1a4; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 14px;"/>
            <Button text="Cancel" onAction="#handleCancel"
                    style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 14px;"/>
        </HBox>
    </VBox>
</AnchorPane>
