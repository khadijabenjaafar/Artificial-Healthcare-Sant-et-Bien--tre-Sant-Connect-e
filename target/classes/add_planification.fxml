<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.AddPlanificationController">
    <children>
        <GridPane layoutX="10.0" layoutY="10.0">
            <children>
                <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <DatePicker fx:id="dateField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Adresse:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="adresseField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Mode:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="modeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Freelancer:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="freelancerComboBox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>


                <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                    <children>
                        <Button text="Save" onAction="#handleSave"/>
                        <Button text="Cancel" onAction="#handleCancel"/>
                    </children>
                </HBox>
            </children>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="200.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
        </GridPane>
    </children>
</AnchorPane>