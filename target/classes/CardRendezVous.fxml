<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.CardRendezVous"
            fx:id="rootPane"
            style="-fx-background-color: #ffffff; -fx-border-color: #dddddd; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4)">
    <VBox spacing="8">
        <Label fx:id="labelDate" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label fx:id="labelMotif"/>
        <Label fx:id="labelStatut"/>
        <Label fx:id="labelMode"/>
        <Label fx:id="labelMedecin"/>
        <Label fx:id="labelPatient"/>
        <Label fx:id="labelCommentaire" wrapText="true"/>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="btnModifier" text="Modifier"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 5;"/>
            <Button fx:id="btnSupprimer" text="Supprimer"
                    style="-fx-background-color: #E53935; -fx-text-fill: white; -fx-background-radius: 5;"/>
        </HBox>
    </VBox>
</AnchorPane>
